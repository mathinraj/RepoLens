# ── Claude auth ──────────────────────────────────────────────
# Enterprise / no API key (recommended): use Claude Code CLI
CLAUDE_PROVIDER=cli
# First-time setup: run `claude auth login` in a terminal
# CLAUDE_BIN=claude
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional — only if you later get an Anthropic Console API key
# CLAUDE_PROVIDER=api
# ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub Enterprise ────────────────────────────────────────
# Classic PAT on github.com with repo read access
GITHUB_TOKEN=ghp_...

# Optional overrides
PORT=3847
GITHUB_API_BASE=https://api.github.com
GITHUB_HOST=github.com
CLAUDE_MAX_TOKENS_INSTANT=2048
CLAUDE_MAX_TOKENS_ENHANCED=4096
